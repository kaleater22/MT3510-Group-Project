   "source": [
    "def weak_isom(A1, A2):\n",
    "    # --------------------------------\n",
    "    # Check whether two DFAs are weakly isomorphic i.e. if there are bijections f: Q1 -> Q2 & g: E1 -> E2 s.t.\n",
    "    # T2(f(q), g(a)) = f(T1(q, a)) for all q in Q1 & a in E1\n",
    "    # f(qs1) = qs2\n",
    "    # f(F1) = F2\n",
    "    # --------------------------------\n",
    "    return check_isom(A1, A2, \"weak\")"
   ]
