   "source": [
    "# Function to check if a given monoid is made entirely of permuations, implemented across all parts of the code\n",
    "def is_permutation(t, Q):\n",
    "    images = [t[q] for q in Q]\n",
    "    return len(set(images)) == len(Q)"
   ]
