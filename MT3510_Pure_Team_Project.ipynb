    "def strict_isom(A1, A2):\n",
    "    # --------------------------------\n",
    "    # Check whether two DFAs are strictly isomorphic i.e. if there is a bijection f: Q1 -> Q2 s.t.\n",
    "    # T2(f(q), a) = f(T1(q, a)) for all q in Q1 & a in E1\n",
    "    # f(qs1) = qs2\n",
    "    # f(F1) = F2\n",
    "    # The alphabet is the same & unchanged\n",
    "    # --------------------------------\n",
    "    return check_isom(A1, A2, \"strict\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "07e57d4c",
   "metadata": {
    "id": "07e57d4c"
   },
   "source": [
    "### 2 (b): Weak isomorphism"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "ecbf239c",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-03-22T19:28:13.977953Z",
     "iopub.status.busy": "2026-03-22T19:28:13.977765Z",
     "iopub.status.idle": "2026-03-22T19:28:13.993246Z",
